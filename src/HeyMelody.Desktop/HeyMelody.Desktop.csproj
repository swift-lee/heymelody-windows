<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(HeyMelodyDesktopTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unmodified static MiSans is shared by every GUI and the Host, including standalone builds. -->
    <Content Include="Fonts/*.otf" Link="fonts/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets/Icons/**/*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="SmoothScroll.Avalonia" Version="12.0.0.14" />
    <PackageReference Include="SmoothScroll.Avalonia.Interaction" Version="12.0.0.15-heymelody.2" />
    <ProjectReference Include="../HeyMelody.Contracts/HeyMelody.Contracts.csproj" />
    <ProjectReference Include="../HeyMelody.Diagnostics/HeyMelody.Diagnostics.csproj" />
    <InternalsVisibleTo Include="HeyMelody" />
    <InternalsVisibleTo Include="HeyMelody.DeviceManager" />
    <InternalsVisibleTo Include="HeyMelody.Calibration.UI" />
    <InternalsVisibleTo Include="HeyMelody.Host" />
    <InternalsVisibleTo Include="HeyMelody.App.Tests" />
    <InternalsVisibleTo Include="HeyMelody.DeviceManager.Tests" />
    <InternalsVisibleTo Include="HeyMelody.Calibration.UI.Tests" />
    <InternalsVisibleTo Include="HeyMelody.ModelPreview.Tests" />
  </ItemGroup>
</Project>
