<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:HeyMelodyWindows.App;assembly=HeyMelody.Client"
             xmlns:contracts="clr-namespace:HeyMelodyWindows.App;assembly=HeyMelody.Contracts"
             xmlns:local="clr-namespace:HeyMelodyWindows.App"
             xmlns:art="clr-namespace:HeyMelodyWindows.Artwork;assembly=HeyMelody.Artwork"
             x:Class="HeyMelodyWindows.App.MainView" x:DataType="vm:MainViewModel"
             Background="Transparent">
  <UserControl.Resources>
    <local:DemoDeviceCaptionConverter x:Key="DemoDeviceCaptionConverter" />
    <local:DeviceCardNameConverter x:Key="DeviceCardNameConverter" />
    <ControlTheme x:Key="DeviceCardTheme" TargetType="ListBoxItem">
      <Setter Property="Width" Value="300" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="AutomationProperties.Name" Value="{Binding ., Converter={StaticResource DeviceCardNameConverter}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource ControlSolidFillColorDefaultBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="CardBorder" Padding="{TemplateBinding Padding}"
                    TemplatedControl.IsTemplateFocusTarget="True"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Style>
      <!-- Only the current device takes the refresh / reconnect gestures (MainView.DeviceBar.cs). -->
      <Style Selector="^:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="ToolTip.Tip" Value="双击刷新状态，三击重新连接" />
        <Setter Property="AutomationProperties.HelpText" Value="当前设备。双击刷新状态，三击重新连接；也可按 F5 刷新、Shift+F5 重新连接。" />
      </Style>
      <!-- Keyboard focus draws the system focus ring on the card edge, also over a selected card. -->
      <Style Selector="^:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#CardBorder">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="fa|FASettingsExpander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ListBox#DevicePicker">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Ellipse#ConnectionDot">
      <Setter Property="Fill" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Ellipse#ConnectionDot.pending">
      <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Ellipse#ConnectionDot.online">
      <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.battery-value">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.band-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Responsive tiers. Code sets only the compact/wide classes; every width below is a style value so that
         each tier can replace it. All tiers keep the hero and the control pane side by side. -->
    <Style Selector="Grid#DeviceArea">
      <Setter Property="Margin" Value="24,12,24,0" />
    </Style>
    <Style Selector="Grid#HeroPanel">
      <Setter Property="Margin" Value="8,0,32,0" />
    </Style>
    <Style Selector="local|ProductArtwork#HeroArt">
      <Setter Property="MaxWidth" Value="600" />
      <Setter Property="MaxHeight" Value="520" />
    </Style>
    <Style Selector="Grid#ControlPane">
      <Setter Property="Width" Value="500" />
    </Style>
    <!-- Below 1080 px: narrower margins and a 480 px pane (FluentAvalonia rows wrap their footers under 460 px). -->
    <Style Selector="local|MainView.compact Grid#DeviceArea">
      <Setter Property="Margin" Value="16,8,16,0" />
    </Style>
    <Style Selector="local|MainView.compact Grid#HeroPanel">
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector="local|MainView.compact local|ProductArtwork#HeroArt">
      <Setter Property="MaxHeight" Value="360" />
    </Style>
    <Style Selector="local|MainView.compact Grid#ControlPane">
      <Setter Property="Width" Value="480" />
    </Style>
    <!-- From 1600 x 1000: a larger hero and pane, centred instead of spreading across very wide screens. -->
    <Style Selector="local|MainView.wide Grid#DeviceArea">
      <Setter Property="MaxWidth" Value="1680" />
    </Style>
    <Style Selector="local|MainView.wide local|ProductArtwork#HeroArt">
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="MaxHeight" Value="640" />
    </Style>
    <Style Selector="local|MainView.wide Grid#ControlPane">
      <Setter Property="Width" Value="540" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="MainLayout" RowDefinitions="*,Auto">
    <Border x:Name="PageSurface" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />
    <Grid x:Name="DeviceArea" ColumnDefinitions="*,Auto">
      <Grid x:Name="HeroPanel">
        <local:ProductArtwork x:Name="HeroArt" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid x:Name="ControlPane" Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <Grid x:Name="DeviceHeader" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,18,8,0">
          <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Margin="2,0,12,0" VerticalAlignment="Center" />
          <TextBlock x:Name="DeviceTitle" Grid.Column="1" Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
          <!-- The only header command: centred on the title and subtitle, its right edge on the cards' edge. Refresh and
               reconnect moved to the current device card (double / triple click) and F5 / Shift+F5. -->
          <Button x:Name="AppSettingsButton" Grid.Column="2" Grid.RowSpan="2" Classes="icon" Click="AppSettings_Click"
                  VerticalAlignment="Center" IsEnabled="{Binding !Closing}" Margin="12,0,0,0"
                  ToolTip.Tip="应用设置" AutomationProperties.Name="应用设置">
            <fa:FAIconSourceElement IconSource="{local:AppIcon Settings, Size=16}" Width="16" Height="16" />
          </Button>
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center" Margin="0,4,0,0">
            <TextBlock x:Name="DeviceSubtitle" Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" ToolTip.Tip="{Binding Subtitle}" />
            <TextBlock x:Name="WarningSeparator" Grid.Column="1" Text="·" Margin="8,0"
                       IsVisible="{Binding HasWarnings}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="HeaderWarnings" Grid.Column="2" IsVisible="{Binding HasWarnings}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WarningsText}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Grid>
        <!-- The activity slot keeps its 3 px; only its opacity changes, so the settings never move. -->
        <ProgressBar x:Name="ActivityBar" Grid.Row="1" Classes="activity" IsIndeterminate="{Binding HasActivity}"
                     Classes.active="{Binding HasActivity}" Margin="0,14,8,0" AutomationProperties.Name="正在处理" />
        <ScrollViewer x:Name="ControlScroll" Grid.Row="2" Margin="0,11,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ControlStack" Margin="0,0,8,24" Spacing="8">
            <fa:FAInfoBar x:Name="PlatformNotice" Severity="Informational" IsClosable="False" IsOpen="False" IsVisible="False"
                          Title="仅预览界面" Message="当前平台不支持蓝牙耳机控制。" />
            <fa:FAInfoBar x:Name="BluetoothPlatformNotice" Severity="Warning" IsClosable="False"
                          IsOpen="{Binding HasPlatformWarning}" IsVisible="{Binding HasPlatformWarning}"
                          Message="{Binding PlatformMessage}" AutomationProperties.LiveSetting="Polite" />
            <fa:FAInfoBar x:Name="DemoNotice" Severity="Informational" IsClosable="False"
                          IsOpen="{Binding IsDemoSelected}" IsVisible="{Binding IsDemoSelected}"
                          Title="布局演示" Message="控件仅模拟交互，关闭窗口后自动移除。" />
            <fa:FAInfoBar x:Name="StatusNotice" Severity="Warning" IsClosable="False" IsOpen="{Binding StatusWarning}"
                          IsVisible="{Binding StatusWarning}" Message="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            <Border x:Name="BatteryPanel" Classes="card" Padding="{StaticResource HmCardPadding}">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <!-- Each cell reads as one phrase, e.g. "左耳 80%，正在充电". -->
                <StackPanel Spacing="6" Background="Transparent" ToolTip.Tip="{Binding LeftChargeText}" Focusable="True">
                  <AutomationProperties.Name>
                    <MultiBinding StringFormat="左耳 {0}，{1}">
                      <Binding Path="LeftBatteryText" />
                      <Binding Path="LeftChargeText" />
                    </MultiBinding>
                  </AutomationProperties.Name>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <fa:FAIconSourceElement x:Name="LeftBatteryDeviceIcon" IconSource="{local:AppIcon BatteryLeft, Size=14}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="左耳" Classes="caption" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding LeftBatteryText}" Classes="battery-value" />
                    <fa:FAIconSourceElement IconSource="{local:AppIcon Charging, Size=18}" Width="18" Height="18" VerticalAlignment="Center"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding LeftCharging}"
                                            AutomationProperties.Name="左耳正在充电" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding RightChargeText}" Focusable="True">
                  <AutomationProperties.Name>
                    <MultiBinding StringFormat="右耳 {0}，{1}">
                      <Binding Path="RightBatteryText" />
                      <Binding Path="RightChargeText" />
                    </MultiBinding>
                  </AutomationProperties.Name>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <fa:FAIconSourceElement x:Name="RightBatteryDeviceIcon" IconSource="{local:AppIcon BatteryRight, Size=14}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="右耳" Classes="caption" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding RightBatteryText}" Classes="battery-value" />
                    <fa:FAIconSourceElement IconSource="{local:AppIcon Charging, Size=18}" Width="18" Height="18" VerticalAlignment="Center"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding RightCharging}"
                                            AutomationProperties.Name="右耳正在充电" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding CaseChargeText}" Focusable="True">
                  <AutomationProperties.Name>
                    <MultiBinding StringFormat="充电盒 {0}，{1}">
                      <Binding Path="CaseBatteryText" />
                      <Binding Path="CaseChargeText" />
                    </MultiBinding>
                  </AutomationProperties.Name>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <fa:FAIconSourceElement x:Name="CaseBatteryDeviceIcon" IconSource="{local:AppIcon BatteryCase, Size=14}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="充电盒" Classes="caption" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding CaseBatteryText}" Classes="battery-value" />
                    <fa:FAIconSourceElement IconSource="{local:AppIcon Charging, Size=18}" Width="18" Height="18" VerticalAlignment="Center"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding CaseCharging}"
                                            AutomationProperties.Name="充电盒正在充电" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock x:Name="SoundGroupHeader" Classes="group-header" Text="声音" />
            <fa:FASettingsExpander x:Name="AncPanel" Header="降噪" Description="调整你听见的环境声音"
                                   IconSource="{local:AppIcon NoiseControl}" IsExpanded="True">
              <local:AncModeSelector />
            </fa:FASettingsExpander>
            <fa:FASettingsExpander x:Name="EqualizerPanel" Header="均衡器" Description="预设与自定义均衡器"
                                   IconSource="{local:AppIcon Equalizer}" IsExpanded="False">
              <Border Padding="{StaticResource HmExpanderContentPadding}">
                <StackPanel Spacing="12">
                  <local:EqualizerChoiceView />
                  <TextBlock Text="{Binding EqHint}" Classes="caption" TextWrapping="Wrap" />
                  <TextBox x:Name="EqNameEditor" Text="{Binding EqName, Mode=TwoWay}" MaxLength="30" PlaceholderText="均衡器名称"
                           IsEnabled="{Binding CanEditEq}" AutomationProperties.Name="均衡器名称" />
                  <ItemsControl x:Name="BandEditor" ItemsSource="{Binding Bands}" IsEnabled="{Binding CanEditEq}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EqBandViewModel">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                          <!-- "+12 dB" is wider than a cell with many bands and the TextBlock clips overflow; shrink to fit instead. -->
                          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding GainLabel}" Classes="band-label" />
                          </Viewbox>
                          <Slider Orientation="Vertical" Height="124" Width="32" Minimum="{Binding Minimum}"
                                  Maximum="{Binding Maximum}" Value="{Binding Gain, Mode=TwoWay}"
                                  TickFrequency="1" IsSnapToTickEnabled="True"
                                  AutomationProperties.Name="{Binding FrequencyHz, StringFormat='{}{0} Hz 增益'}">
                            <!-- The vertical template reserves 14 + 18 + 14 = 46 px; in a 32 px slot the thumb sat 7 px right of centre and its
                                 hover-scaled ellipse crossed the edge. 7 + 18 + 7 = 32 centres it. -->
                            <Slider.Resources>
                              <GridLength x:Key="SliderPreContentMargin">7</GridLength>
                              <GridLength x:Key="SliderPostContentMargin">7</GridLength>
                            </Slider.Resources>
                          </Slider>
                          <TextBlock Text="{Binding FrequencyLabel}" Classes="band-label" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Draft state and its commands share one row. -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding EqDirtyText}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="恢复当前" Command="{Binding ResetEqCommand}" />
                      <Button Content="保存并启用" Command="{Binding SaveEqCommand}" Classes="accent" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <!-- BassWave rows follow as native items of this expander; code-behind reuses them by feature id. -->
            </fa:FASettingsExpander>
            <ItemsControl x:Name="SoundSectionsView">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:FeatureSectionSlot">
                  <local:FeatureSectionView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="HearingGroupHeader" Classes="group-header" Text="听感与佩戴" />
            <fa:FASettingsExpander x:Name="HearingPanel" Header="黄金听感" Description="个性化听感配置"
                                   IconSource="{local:AppIcon Hearing}" IsExpanded="False">
              <fa:FASettingsExpanderItem Content="听感配置">
                <fa:FASettingsExpanderItem.Footer>
                  <ComboBox x:Name="HearingProfileCombo" ItemsSource="{Binding HearingProfiles}" MinWidth="180" MaxWidth="230"
                            SelectedItem="{Binding SelectedHearingProfile, Mode=OneWay}" IsEnabled="{Binding CanSelectHearingProfile}"
                            PlaceholderText="暂无配置" AutomationProperties.Name="黄金听感配置">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="contracts:UiHearingProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
              <fa:FASettingsExpanderItem Content="建立听感" Description="完成听力测试，生成专属配置">
                <fa:FASettingsExpanderItem.Footer>
                  <Button Content="设置黄金听感" Click="HearingSetup_Click" IsEnabled="{Binding CanSetupHearing}" />
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>
            <!-- An item-less settings expander is FluentAvalonia's plain card: no chevron, footer on the right. -->
            <fa:FASettingsExpander x:Name="FitTestPanel" Header="耳塞贴合度测试" Description="检查两耳的佩戴贴合度"
                                   IconSource="{local:AppIcon FitTest}">
              <fa:FASettingsExpander.Footer>
                <Button Content="开始测试" Click="FitTest_Click" IsEnabled="{Binding CanFitTest}" />
              </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <TextBlock x:Name="DeviceGroupHeader" Classes="group-header" Text="设备" />
            <ItemsControl x:Name="DeviceSectionsView">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:FeatureSectionSlot">
                  <local:FeatureSectionView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <fa:FASettingsExpander x:Name="DeviceInfoPanel" Header="设备信息" Description="名称、产品编号与固件"
                                   IconSource="{local:AppIcon Info}" IsExpanded="False">
              <Border Padding="{StaticResource HmExpanderContentPadding}">
                <StackPanel Spacing="16">
                  <Grid x:Name="DeviceInfoFields" ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="设备名称" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="产品编号" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductId, TargetNullValue=—}" />
                    <TextBlock Grid.Row="2" Text="固件版本" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Firmware, TargetNullValue=—}" TextWrapping="Wrap" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock x:Name="DeviceInfoCopyStatus" Classes="caption" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="CopyDeviceInfoButton" Click="CopyDeviceInfo_Click" IsEnabled="False"
                            ToolTip.Tip="复制设备名称、产品编号与固件版本" AutomationProperties.Name="复制设备信息">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <fa:FAIconSourceElement IconSource="{local:AppIcon Copy, Size=16}" Width="16" Height="16" />
                        <TextBlock Text="复制" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander x:Name="OperationLogPanel" Header="操作记录" Description="本次运行的最近操作"
                                   IconSource="{local:AppIcon History}" IsExpanded="False">
              <Border Padding="{StaticResource HmExpanderContentPadding}">
                <TextBox x:Name="OperationLogText" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="200" FontSize="12" AutomationProperties.Name="操作记录" />
              </Border>
            </fa:FASettingsExpander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border x:Name="DeviceBar" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="Transparent" Padding="20,8">
      <ScrollViewer x:Name="DeviceBarScroll" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <Border x:Name="DeviceStripPadding" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel x:Name="DeviceStrip" Orientation="Horizontal" Spacing="8" MinHeight="64">
            <Grid>
              <ListBox x:Name="DevicePicker" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=OneWay}"
                       ItemContainerTheme="{StaticResource DeviceCardTheme}"
                       SelectionChanged="Device_SelectionChanged" IsEnabled="{Binding CanRefreshDevices}"
                       MinHeight="64" AutoScrollToSelectedItem="False"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="设备切换">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="contracts:UiDevice">
                    <Grid x:Name="DeviceCardContent" ColumnDefinitions="32,Auto" ColumnSpacing="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox x:Name="DeviceIcon" Width="28" Height="28" Stretch="Uniform" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:FAIconSourceElement IconSource="{local:AppIcon Earbuds, Size=24}" Width="24" Height="24" />
                      </Viewbox>
                      <StackPanel x:Name="DeviceText" Grid.Column="1" Spacing="4" MaxWidth="220">
                        <TextBlock x:Name="DeviceNameText" Text="{Binding Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding ., Converter={StaticResource DemoDeviceCaptionConverter}}" Classes="caption" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EmptyDevicesText" Text="暂无已配对设备"
                         IsVisible="{Binding !HasDevices}" Classes="muted" VerticalAlignment="Center" Margin="8,0" />
            </Grid>
            <Border x:Name="AddDeviceHost" VerticalAlignment="Center" CornerRadius="4"
                    Background="{DynamicResource ControlSolidFillColorDefaultBrush}">
              <Button x:Name="AddDeviceButton" Width="64" Height="64" Click="AddDevice_Click"
                      IsEnabled="{Binding !Closing}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="添加设备；长按 2 秒显示 Demo 设备" AutomationProperties.Name="添加设备">
                <fa:FASymbolIcon Symbol="Add" FontSize="24" />
              </Button>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
    <art:GpuJanitor HorizontalAlignment="Left" VerticalAlignment="Top" />
  </Grid>
</UserControl>
