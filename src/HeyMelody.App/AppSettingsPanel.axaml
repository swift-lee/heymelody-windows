<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="HeyMelodyWindows.App.AppSettingsPanel">
  <UserControl.Styles>
    <Style Selector="TextBlock.settings-group">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="1,16,0,6" />
    </Style>
    <Style Selector="fa|FASettingsExpanderItem">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>
  </UserControl.Styles>
  <StackPanel x:Name="SettingsRoot" MinWidth="460" Spacing="0">
    <TextBlock Classes="settings-group" Text="外观" Margin="1,0,0,6" />
    <fa:FASettingsExpanderItem Content="应用主题" Description="选择界面的颜色模式，选择后立即预览">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="DarkTheme" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <ComboBox x:Name="ThemeChoice" MinWidth="150" AutomationProperties.Name="应用主题" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>

    <fa:FASettingsExpanderItem x:Name="UiBasicRenderCard" Content="使用 Basic Render 兼容模式"
                               Description="显示异常时尝试启用，会降低流畅度；重新打开主界面后生效">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="Sync" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <ToggleSwitch x:Name="UiBasicRenderSwitch" OnContent="开" OffContent="关"
                      AutomationProperties.Name="使用 Basic Render 兼容模式" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>

    <fa:FASettingsExpanderItem x:Name="ModelCompatibilityCard" Content="3D模型渲染API"
                               Description="若存在渲染问题，请尝试切换到 OpenGL">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="Sync" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <ComboBox x:Name="ModelBackendChoice" MinWidth="150" AutomationProperties.Name="3D模型渲染API" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>
    <fa:FASettingsExpanderItem x:Name="ModelFrameRateCard" Content="3D模型渲染帧率">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="Rotate" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <Grid x:Name="ModelFrameRateEditor" Width="216" RowDefinitions="Auto,20">
          <Slider x:Name="ModelFrameRateSlider" Margin="28,0" Minimum="0" Maximum="2" Value="2"
                  TickFrequency="1" Ticks="0,1,2" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                  SmallChange="1" LargeChange="1" AutomationProperties.Name="3D模型渲染帧率" />
          <Canvas x:Name="ModelFrameRateLabels" Grid.Row="1" Height="20" IsHitTestVisible="False">
            <TextBlock x:Name="ModelFrameRate30Label" Text="30帧" FontSize="12" />
            <TextBlock x:Name="ModelFrameRate60Label" Text="60帧" FontSize="12" />
            <TextBlock x:Name="ModelFrameRateUnlimitedLabel" Text="无限制" FontSize="12" />
          </Canvas>
        </Grid>
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>

    <TextBlock Classes="settings-group" Text="耳机资源" />
    <TextBlock x:Name="ResourceLockNotice" Classes="caption" TextWrapping="Wrap" Margin="2,0,0,6" IsVisible="False"
               Text="正在连接或切换耳机，完成后可修改资源与设备设置。" />
    <fa:FASettingsExpanderItem Content="使用在线资源" Description="关闭后，已缓存的较新版本仍可使用">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="Globe" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <ToggleSwitch x:Name="OnlineSwitch" OnContent="开" OffContent="关" AutomationProperties.Name="使用在线资源" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>
    <fa:FASettingsExpanderItem Content="自定义云端密钥" Description="留空时使用欢律预置密钥">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="Permissions" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <TextBox x:Name="KeyBox" Width="190" PasswordChar="●" PlaceholderText="自定义云端密钥" MaxLength="1024"
                 AutomationProperties.Name="云端资源密钥" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>
    <fa:FASettingsExpanderItem x:Name="RedownloadCard" Content="重新下载在线资源">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="CloudDownload" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <fa:FAProgressRing x:Name="RedownloadProgress" IsIndeterminate="False" Width="20" Height="20" IsVisible="False"
                             VerticalAlignment="Center" AutomationProperties.Name="正在重新下载在线资源" />
          <Button x:Name="RedownloadButton" Content="重新下载" AutomationProperties.Name="重新下载在线资源" />
        </StackPanel>
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>
    <fa:FAInfoBar x:Name="RedownloadResult" IsClosable="True" IsOpen="False" IsVisible="False" Margin="0,0,0,4" />
    <TextBlock x:Name="ResourceStatusText" Classes="caption" TextWrapping="Wrap" Margin="2,2,0,0" />

    <TextBlock Classes="settings-group" Text="设备" />
    <fa:FASettingsExpanderItem Content="耳机列表" Description="选择由 HeyMelody 控制的已配对耳机">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="SpeakerBluetooth" /></fa:FASettingsExpanderItem.IconSource>
      <fa:FASettingsExpanderItem.Footer>
        <Button x:Name="ManageDevicesButton" Content="管理设备" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>

    <TextBlock Classes="settings-group" Text="故障诊断" />
    <fa:FASettingsExpander x:Name="DiagnosticExpander" Header="诊断日志"
                           Description="按组件记录 Debug 日志，仅用于故障诊断">
      <fa:FASettingsExpanderItem Content="HeyMelody">
        <fa:FASettingsExpanderItem.Footer><CheckBox x:Name="LogMainCheck" AutomationProperties.Name="HeyMelody" /></fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="HeyMelody.Host" Description="托盘后台、蓝牙通信及设备 worker">
        <fa:FASettingsExpanderItem.Footer><CheckBox x:Name="LogHostCheck" AutomationProperties.Name="HeyMelody.Host" /></fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="HeyMelody.DeviceManager">
        <fa:FASettingsExpanderItem.Footer><CheckBox x:Name="LogManagerCheck" AutomationProperties.Name="HeyMelody.DeviceManager" /></fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="HeyMelody.FitTest">
        <fa:FASettingsExpanderItem.Footer><CheckBox x:Name="LogFitCheck" AutomationProperties.Name="HeyMelody.FitTest" /></fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="HeyMelody.HearingSetup">
        <fa:FASettingsExpanderItem.Footer><CheckBox x:Name="LogHearingCheck" AutomationProperties.Name="HeyMelody.HearingSetup" /></fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="在下次启动程序时记录日志"
                                 Description="保存后，退出并重新启动托盘后台开始记录；该轮后台退出后自动关闭">
        <fa:FASettingsExpanderItem.Footer>
          <ToggleSwitch x:Name="LogNextStartSwitch" OnContent="开" OffContent="关" AutomationProperties.Name="在下次启动程序时记录日志" />
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
      <StackPanel Spacing="8" Margin="16,8,16,12">
        <TextBlock Text="日志包含完整协议收发、设备标识、本地路径等运行信息，可能涉及个人信息。仅在排障时启用，分享前请自行检查。"
                   Classes="caption" TextWrapping="Wrap" />
        <TextBlock x:Name="LogStatusText" TextWrapping="Wrap" />
        <TextBlock x:Name="LogDirectoryText" Classes="caption" TextWrapping="Wrap" />
        <Button x:Name="OpenLogDirectoryButton" Content="打开日志目录" AutomationProperties.Name="打开日志目录" HorizontalAlignment="Left" />
        <fa:FAInfoBar x:Name="LogSettingsNotice" Title="诊断日志" Severity="Warning" IsOpen="False" IsVisible="False" IsClosable="False" />
      </StackPanel>
    </fa:FASettingsExpander>

    <TextBlock Classes="settings-group" Text="关于" />
    <fa:FASettingsExpanderItem x:Name="AboutCard" Description="社区客户端 · 通过蓝牙管理已配对的耳机">
      <fa:FASettingsExpanderItem.IconSource><fa:FASymbolIconSource Symbol="Help" /></fa:FASettingsExpanderItem.IconSource>
    </fa:FASettingsExpanderItem>
  </StackPanel>
</UserControl>
