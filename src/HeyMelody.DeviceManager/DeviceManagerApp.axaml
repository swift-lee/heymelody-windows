<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             x:Class="HeyMelodyWindows.DeviceManager.DeviceManagerApp">
  <Application.Styles>
    <styling:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
    <StyleInclude Source="avares://HeyMelody.Desktop/Styles/HeyMelodyTheme.axaml" />
  </Application.Styles>
</Application>
