<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HeyMelody.DeviceManager</AssemblyName>
    <RootNamespace>HeyMelodyWindows.DeviceManager</RootNamespace>
    <Version>0.9.2</Version><RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon>../HeyMelody.App/Assets/HeyMelody.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="SmoothScroll.Avalonia" Version="12.0.0.14" />
    <PackageReference Include="SmoothScroll.Avalonia.Interaction" Version="12.0.0.15-heymelody.2" />
    <ProjectReference Include="../HeyMelody.Client/HeyMelody.Client.csproj" />
    <ProjectReference Include="../HeyMelody.Artwork/HeyMelody.Artwork.csproj" />
    <!-- Rendering and typography setup are compiled from the main window's sources, not a new assembly. -->
    <Compile Include="../HeyMelody.App/RenderingSetup.cs" Link="Shared/RenderingSetup.cs" />
    <Compile Include="../HeyMelody.App/WindowsWarpAdapterResolver.cs" Link="Shared/WindowsWarpAdapterResolver.cs" />
    <Compile Include="../HeyMelody.App/Typography.cs" Link="Shared/Typography.cs" />
    <Compile Include="../HeyMelody.App/UiMetrics.cs" Link="Shared/UiMetrics.cs" />
    <Compile Include="../HeyMelody.App/SmoothScrolling.cs" Link="Shared/SmoothScrolling.cs" />
    <Compile Include="../HeyMelody.App/UiDiagnosticLogging.cs" Link="Shared/UiDiagnosticLogging.cs" />
    <AvaloniaXaml Include="../HeyMelody.App/Styles/HeyMelodyTheme.axaml" Link="Styles/HeyMelodyTheme.axaml" />
    <AvaloniaResource Include="../HeyMelody.App/Assets/HeyMelody.ico" Link="Assets/HeyMelody.ico" />
    <InternalsVisibleTo Include="HeyMelody.DeviceManager.Tests" />
  </ItemGroup>
</Project>
