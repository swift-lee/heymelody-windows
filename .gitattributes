* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.xaml text eol=lf
*.axaml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary
# Embedded profile is verified byte-for-byte by its SHA256; never change line endings.
src/HeyMelody.Devices/Assets/oppo-enco-x4.json -text
# Catalog and artwork hashes require the original bytes on every checkout.
src/HeyMelody.Resources/Bundles/** -text
*.otf binary
# Preserve the exact upstream UI bytes verified by the font/icon source manifests.
src/HeyMelody.Desktop/Assets/Icons/*.svg -text
packaging/licenses/Fluent-System-Icons-MIT.txt -text
packaging/licenses/MiSans-Font-License.pdf binary
# Preserve the official Inno Setup license and translation byte for byte.
packaging/inno/LICENSE.txt -text whitespace=cr-at-eol
packaging/inno/Languages/ChineseSimplified.isl -text whitespace=cr-at-eol
# Keep the upstream smooth-scroll license copies identical to their recorded SHA256.
docs/licenses/SmoothScroll.Avalonia-LICENSE.txt -text
packaging/licenses/SmoothScroll.Avalonia-LICENSE.txt -text
# The local dependency rebuild verifies the patch bytes on every checkout.
vendor/smooth-scroll/precision-touchpad.patch -text -whitespace
vendor/smooth-scroll/UPSTREAM.json text eol=lf
vendor/nuget/*.nupkg binary
